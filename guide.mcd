document "Minecraft Guide"

description "A complete Minecraft reference covering mechanics, building, redstone, resources, farming, transportation, storage, and gameplay."

< ============================================================
  MINECRAFT GUIDE
  .mcd = Minecraft Document

  Editor notes:
  Anything between < and > is ignored by the reader.

  Main structure:
  document
      topic
          section
              subsection
                  content
              end
          end
      end
  end

  Available content:
  text
  image
  list
  table
  tip
  note
  warning
  code
  ============================================================ >


topic "Beacons"

    description "Everything you need to know about beacons."

    section "Beacon Basics"

        subsection "What Is a Beacon?"

            text
                A beacon is a utility block that can provide
                beneficial status effects to players when it
                is activated above a valid pyramid.
            end

            image "images/beacons/beacon.png"
                title "Beacon"
                alt "A Minecraft beacon."
                caption "A beacon with its beam activated."
                width 400
                position center
            end

        end


        subsection "How Beacons Work"

            text
                A beacon is placed on top of a pyramid made from
                valid mineral blocks. The size of the pyramid
                determines which beacon effects are available.
            end

            note
                The beacon block itself is not included when
                counting the mineral blocks in the pyramid.
            end

        end


        subsection "Activating a Beacon"

            text
                Build a valid pyramid underneath the beacon and
                provide the beacon with a clear path to the sky.
                Once activated, the beacon can be configured
                through its interface.
            end

            tip
                Plan the pyramid before building it so the beacon
                is centered on the structure.
            end

        end


        subsection "Beacon Beam"

            text
                An active beacon produces a visible beam extending
                upward from the beacon.
            end

            image "images/beacons/beam.png"
                title "Beacon Beam"
                alt "A vertical beam produced by a Minecraft beacon."
                caption "The beam makes an active beacon easy to locate."
                width 500
                position center
            end

        end

    end


    section "Beacon Pyramid"

        subsection "Level 1"

            text
                A level 1 beacon uses one 3 × 3 layer.
            end

            table

                headers
                    Layer | Size | Blocks
                end

                row
                    1 | 3 × 3 | 9
                end

                row
                    Total | — | 9
                end

            end

            image "images/beacons/level-1.png"
                title "Level 1 Beacon"
                alt "A level 1 beacon pyramid."
                caption "One 3 × 3 layer."
                width 350
                position center
            end

        end


        subsection "Level 2"

            text
                A level 2 beacon uses two layers.
            end

            table

                headers
                    Layer | Size | Blocks
                end

                row
                    1 | 5 × 5 | 25
                end

                row
                    2 | 3 × 3 | 9
                end

                row
                    Total | — | 34
                end

            end

            image "images/beacons/level-2.png"
                title "Level 2 Beacon"
                alt "A level 2 beacon pyramid."
                caption "Two layers containing 34 mineral blocks."
                width 400
                position center
            end

        end


        subsection "Level 3"

            text
                A level 3 beacon uses three layers.
            end

            table

                headers
                    Layer | Size | Blocks
                end

                row
                    1 | 7 × 7 | 49
                end

                row
                    2 | 5 × 5 | 25
                end

                row
                    3 | 3 × 3 | 9
                end

                row
                    Total | — | 83
                end

            end

            image "images/beacons/level-3.png"
                title "Level 3 Beacon"
                alt "A level 3 beacon pyramid."
                caption "Three layers containing 83 mineral blocks."
                width 450
                position center
            end

        end


        subsection "Level 4"

            text
                A level 4 beacon is the largest standard beacon
                pyramid and uses four layers.
            end

            table

                headers
                    Layer | Size | Blocks
                end

                row
                    1 | 9 × 9 | 81
                end

                row
                    2 | 7 × 7 | 49
                end

                row
                    3 | 5 × 5 | 25
                end

                row
                    4 | 3 × 3 | 9
                end

                row
                    Total | — | 164
                end

            end

            image "images/beacons/level-4.png"
                title "Level 4 Beacon"
                alt "A complete four-layer beacon pyramid."
                caption "Four layers containing 164 mineral blocks."
                width 500
                position center
            end

        end

    end


    section "Beacon Materials"

        subsection "Valid Pyramid Blocks"

            list
                Iron Block
                Gold Block
                Emerald Block
                Diamond Block
                Netherite Block
            end

            tip
                Different valid mineral blocks can be mixed
                together in the same pyramid.
            end

        end


        subsection "Choosing a Material"

            text
                The material used for the pyramid does not have
                to match the material used for any other part of
                the build. Choose a material based on availability,
                appearance, or the style of the surrounding build.
            end

        end

    end


    section "Beacon Effects"

        subsection "Primary Effects"

            text
                An activated beacon can provide a selected primary
                status effect to eligible players within its range.
            end

        end


        subsection "Secondary Effects"

            text
                A fully constructed beacon provides additional
                effect configuration options.
            end

        end


        subsection "Changing Effects"

            text
                Use the beacon interface to select an available
                effect and provide the required item to activate
                the selection.
            end

        end

    end

end


topic "Redstone"

    description "Learn how redstone works and how to build useful machines."

    section "Redstone Basics"

        subsection "Redstone Dust"

            text
                Redstone dust is used to transmit redstone signals
                between components.
            end

            image "images/redstone/redstone-dust.png"
                title "Redstone Dust"
                alt "Redstone dust placed on blocks."
                width 400
                position center
            end

        end


        subsection "Redstone Signals"

            text
                Redstone signals can activate compatible components.
                Understanding signal paths is one of the most
                important parts of learning redstone.
            end

        end


        subsection "Power Sources"

            list
                Lever
                Button
                Pressure Plate
                Redstone Torch
                Tripwire
                Observer
                Other Redstone Components
            end

        end

    end


    section "Redstone Components"

        subsection "Hopper"

            text
                A hopper transfers items between inventories and
                can also interact with redstone signals.
            end

            image "images/redstone/hopper.png"
                title "Hopper"
                alt "A Minecraft hopper."
                width 350
                position center
            end

        end


        subsection "Comparator"

            text
                A comparator can read certain block states and
                interact with redstone signals.
            end

        end


        subsection "Repeater"

            text
                A repeater can transmit a redstone signal forward,
                add delay, and help control signal direction.
            end

        end


        subsection "Observer"

            text
                An observer detects certain changes and produces
                a redstone pulse when its detection condition occurs.
            end

        end


        subsection "Piston"

            text
                Pistons can push blocks and are commonly used to
                create doors, farms, machines, traps, and mechanisms.
            end

        end


        subsection "Sticky Piston"

            text
                Sticky pistons can push blocks and can also pull
                certain blocks back when they retract.
            end

        end

    end


    section "Circuits"

        subsection "Pulse Circuit"

            text
                A pulse circuit produces a temporary redstone
                signal rather than keeping a component powered.
            end

        end


        subsection "Clock Circuit"

            text
                A redstone clock repeatedly produces signals.
                Different clock designs can operate at different
                timings and serve different purposes.
            end

            warning
                Fast clocks can create unnecessary updates and
                may cause performance problems in large builds.
            end

        end


        subsection "Toggle Circuit"

            text
                A toggle circuit allows an input to change a
                machine between two persistent states.
            end

        end

    end


    section "Redstone Machines"

        subsection "Automatic Door"

            text
                Redstone can be used to create doors that open
                automatically when a player activates an input.
            end

        end


        subsection "Item Sorter"

            text
                Item sorting systems use hoppers and redstone
                components to route items into specific storage.
            end

            image "images/redstone/item-sorter.png"
                title "Item Sorter"
                alt "An automatic Minecraft item sorting system."
                width 600
                position center
            end

            tip
                Design the input, filters, storage, and overflow
                sections before building a large sorting system.
            end

        end


        subsection "Automatic Farm"

            text
                Redstone can automate parts of many farms by
                detecting changes, moving blocks, collecting items,
                or controlling mechanisms.
            end

        end

    end

end


topic "Building"

    description "Building techniques, structure design, proportions, and decoration."

    section "Foundations"

        subsection "Basic Foundations"

            text
                A foundation establishes the footprint of a
                structure and helps determine its proportions.
            end

        end


        subsection "Large Foundations"

            text
                Large buildings benefit from clearly planned
                corners, entrances, walls, and interior spaces.
            end

            tip
                Mark the entire footprint before building upward.
            end

        end

    end


    section "Walls"

        subsection "Wall Design"

            text
                Walls can combine structural blocks, supports,
                windows, arches, pillars, and decorative details.
            end

        end


        subsection "Wall Depth"

            text
                Adding depth to a wall can make a large structure
                look more detailed than a completely flat surface.
            end

        end

    end


    section "Towers"

        subsection "Tower Basics"

            text
                Towers can be used for defense, observation,
                decoration, or as architectural landmarks.
            end

        end


        subsection "Tower Proportions"

            text
                A tower should be planned around its base width,
                total height, interior space, and connection to
                the surrounding structure.
            end

        end

    end


    section "Roofs"

        subsection "Roof Design"

            text
                Roof shape has a major effect on the appearance
                and perceived scale of a building.
            end

        end


        subsection "Roof Overhang"

            text
                An overhang can help visually separate the roof
                from the walls and provide additional detail.
            end

        end

    end


    section "Decorative Building"

        subsection "Depth"

            text
                Use layers, supports, trim, windows, and recessed
                areas to create visual depth.
            end

        end


        subsection "Repeating Patterns"

            text
                Repeating architectural patterns can make large
                structures feel intentional and organized.
            end

        end


        subsection "Color and Materials"

            text
                Combining a primary building material with a small
                number of complementary materials can create a
                consistent architectural style.
            end

        end

    end

end


topic "Storage"

    description "Containers, storage systems, capacity, and organization."

    section "Containers"

        subsection "Chest"

            text
                Chests provide item storage and can be combined
                into larger storage arrangements.
            end

        end


        subsection "Barrel"

            text
                Barrels provide item storage and can be useful
                where a compact container is preferred.
            end

        end


        subsection "Shulker Box"

            text
                Shulker boxes provide portable storage because
                their contents remain inside when the box is broken.
            end

        end

    end


    section "Storage Systems"

        subsection "Manual Storage"

            text
                Manual storage systems organize items into
                dedicated containers without automatic sorting.
            end

        end


        subsection "Automatic Storage"

            text
                Automatic storage systems can use hoppers and
                redstone to move and sort items.
            end

        end


        subsection "Overflow"

            text
                A good storage system should have a plan for
                items that do not match any filter.
            end

            warning
                Always account for overflow before filling a
                large automatic storage system with items.
            end

        end

    end


    section "Organization"

        subsection "Categories"

            list
                Building Blocks
                Natural Blocks
                Ores
                Tools
                Weapons
                Armor
                Food
                Redstone
                Transportation
                Decoration
                Miscellaneous
            end

        end

    end

end


topic "Transportation"

    description "Ways to travel around Minecraft worlds and dimensions."

    section "Walking"

        subsection "Basic Travel"

            text
                Walking is the simplest form of transportation
                and works in almost every environment.
            end

        end


        subsection "Sprint Travel"

            text
                Sprinting allows players to travel faster than
                normal walking when conditions allow it.
            end

        end

    end


    section "Boats"

        subsection "Water Travel"

            text
                Boats are useful for traveling across bodies
                of water.
            end

            image "images/transportation/boat.png"
                title "Boat"
                alt "A Minecraft boat."
                width 400
                position center
            end

        end

    end


    section "Minecarts"

        subsection "Railways"

            text
                Minecarts travel along rails and can be used to
                create dedicated transportation routes.
            end

        end


        subsection "Rail Stations"

            text
                A railway station can provide organized entrances,
                exits, loading areas, and destinations.
            end

        end

    end


    section "Nether Travel"

        subsection "Nether Routes"

            text
                Nether routes can connect distant Overworld
                locations more efficiently than many direct
                Overworld routes.
            end

            tip
                Record the coordinates of important portals so
                routes remain easy to maintain.
            end

        end

    end

end


topic "Resources"

    description "Obtaining, processing, storing, and using Minecraft resources."

    section "Mining"

        subsection "Mining Basics"

            text
                Mining is one of the primary ways to obtain
                underground resources.
            end

        end


        subsection "Mining Safety"

            list
                Carry sufficient tools.
                Bring a reliable food source.
                Keep track of your coordinates.
                Watch for hazards.
                Bring a way to mark important locations.
            end

        end

    end


    section "Ores"

        subsection "Coal"

            text
                Coal is a commonly obtained resource with uses
                including fuel and crafting.
            end

        end


        subsection "Iron"

            text
                Iron is an important resource used for tools,
                armor, containers, redstone components, and many
                other crafting recipes.
            end

        end


        subsection "Copper"

            text
                Copper is used in building, decoration, and
                several specialized crafting recipes.
            end

        end


        subsection "Gold"

            text
                Gold is used for crafting, decoration, trading,
                and several specialized gameplay systems.
            end

        end


        subsection "Redstone"

            text
                Redstone is an important resource for automation
                and mechanical systems.
            end

        end


        subsection "Lapis Lazuli"

            text
                Lapis lazuli is used for enchanting and several
                crafting and decorative purposes.
            end

        end


        subsection "Diamond"

            text
                Diamond is a valuable resource used for advanced
                equipment and several important crafting recipes.
            end

        end


        subsection "Emerald"

            text
                Emeralds are primarily associated with villager
                trading and can also be used as a building material.
            end

        end

    end


    section "Nether Resources"

        subsection "Nether Quartz"

            text
                Nether quartz is obtained in the Nether and has
                uses in crafting, decoration, and redstone.
            end

        end


        subsection "Ancient Debris"

            text
                Ancient debris is a rare Nether resource used
                as part of the process for obtaining netherite.
            end

        end

    end


    section "Resource Processing"

        subsection "Furnace"

            text
                Furnaces process many items using fuel.
            end

        end


        subsection "Blast Furnace"

            text
                Blast furnaces are specialized for processing
                certain materials more efficiently than a normal
                furnace.
            end

        end


        subsection "Smoker"

            text
                Smokers are specialized for cooking food.
            end

        end

    end

end


topic "Farming"

    description "Crop farms, animal farms, food production, and automation."

    section "Crops"

        subsection "Wheat"

            text
                Wheat can be grown from seeds and is useful for
                food production and animal breeding.
            end

        end


        subsection "Carrots"

            text
                Carrots can be grown as a crop and used as food
                and for certain animal-related purposes.
            end

        end


        subsection "Potatoes"

            text
                Potatoes can be planted, harvested, and cooked
                into food.
            end

        end


        subsection "Beetroots"

            text
                Beetroots can be grown as a crop and used for
                food and crafting.
            end

        end

    end


    section "Animals"

        subsection "Animal Breeding"

            text
                Many animals can be bred by providing them with
                their appropriate food.
            end

        end


        subsection "Animal Pens"

            text
                Animal pens should provide enough space for the
                animals while preventing unwanted escapes.
            end

            tip
                Keep different animal types in clearly separated
                areas when building a large farm.
            end

        end

    end


    section "Automatic Farms"

        subsection "Farm Design"

            text
                Automatic farms use Minecraft mechanics to reduce
                the amount of manual harvesting or collection.
            end

        end


        subsection "Item Collection"

            text
                Hoppers, water streams, and other collection
                mechanisms can move harvested items into storage.
            end

        end

    end

end


topic "World"

    description "Coordinates, chunks, dimensions, terrain, and world generation."

    section "Coordinates"

        subsection "Coordinate Basics"

            text
                Minecraft coordinates identify a position using
                X, Y, and Z values.
            end

            table

                headers
                    Coordinate | Meaning
                end

                row
                    X | East and West
                end

                row
                    Y | Vertical position
                end

                row
                    Z | North and South
                end

            end

        end


        subsection "Recording Locations"

            text
                Record the coordinates of important locations such
                as bases, villages, portals, farms, mines, and
                important structures.
            end

            tip
                Include a name and description with coordinates
                instead of recording only the three numbers.
            end

        end

    end


    section "Chunks"

        subsection "What Is a Chunk?"

            text
                A chunk is a section of the Minecraft world that
                the game manages as a unit.
            end

        end


        subsection "Chunk Boundaries"

            text
                Knowing chunk boundaries can be useful when
                designing farms, technical builds, and large
                structures.
            end

        end

    end


    section "Dimensions"

        subsection "Overworld"

            text
                The Overworld is the primary Minecraft dimension.
                It contains a wide variety of terrain, structures,
                resources, and biomes.
            end

            image "images/world/overworld.png"
                title "Overworld"
                alt "Minecraft Overworld terrain."
                width 600
                position center
            end

        end


        subsection "Nether"

            text
                The Nether is a separate dimension with its own
                terrain, resources, structures, and hazards.
            end

            image "images/world/nether.png"
                title "Nether"
                alt "Minecraft Nether environment."
                width 600
                position center
            end

        end


        subsection "End"

            text
                The End is a separate dimension containing unique
                terrain, structures, and gameplay.
            end

            image "images/world/end.png"
                title "The End"
                alt "Minecraft End dimension."
                width 600
                position center
            end

        end

    end


    section "World Generation"

        subsection "Biomes"

            text
                Biomes determine many characteristics of an area,
                including terrain, vegetation, weather behavior,
                and naturally occurring features.
            end

        end


        subsection "Structures"

            text
                Generated structures can provide resources,
                challenges, exploration opportunities, and
                locations for future builds.
            end

        end

    end

end


topic "Gameplay"

    description "Core Minecraft gameplay systems and progression."

    section "Villagers"

        subsection "Villager Basics"

            text
                Villagers can take professions, trade with players,
                and interact with various blocks and systems.
            end

        end


        subsection "Villager Professions"

            list
                Armorer
                Butcher
                Cartographer
                Cleric
                Farmer
                Fisherman
                Fletcher
                Leatherworker
                Librarian
                Mason
                Shepherd
                Toolsmith
                Weaponsmith
            end

        end


        subsection "Trading"

            text
                Villager trading allows players to exchange items
                for emeralds and other useful goods.
            end

            tip
                Organize trading areas so each villager can be
                identified and accessed easily.
            end

        end

    end


    section "Enchanting"

        subsection "Enchantments"

            text
                Enchantments can give compatible equipment
                additional abilities or improved properties.
            end

        end


        subsection "Enchanting Table"

            text
                An enchanting table is used to apply available
                enchantments to compatible items.
            end

        end


        subsection "Bookshelves"

            text
                Bookshelves can affect the enchantment options
                available around an enchanting setup.
            end

        end

    end


    section "Brewing"

        subsection "Brewing Basics"

            text
                Brewing allows players to create potions with
                various effects.
            end

        end


        subsection "Brewing Stand"

            text
                The brewing stand is the primary block used for
                brewing potions.
            end

        end

    end


    section "Combat"

        subsection "Weapons"

            list
                Sword
                Axe
                Bow
                Crossbow
                Trident
            end

        end


        subsection "Armor"

            list
                Helmet
                Chestplate
                Leggings
                Boots
            end

        end


        subsection "Preparation"

            text
                Before entering a dangerous area, prepare suitable
                equipment, food, tools, and supplies.
            end

        end

    end

end


topic "Tools"

    description "Tools, equipment, and efficient tool usage."

    section "Pickaxe"

        subsection "Uses"

            text
                Pickaxes are primarily used for mining blocks
                efficiently and are required for obtaining some
                resources.
            end

        end

    end


    section "Axe"

        subsection "Uses"

            text
                Axes are useful for collecting many wood-based
                blocks and can also serve as weapons.
            end

        end

    end


    section "Shovel"

        subsection "Uses"

            text
                Shovels are useful for quickly collecting blocks
                such as dirt, sand, gravel, and similar materials.
            end

        end

    end


    section "Hoe"

        subsection "Uses"

            text
                Hoes are primarily associated with preparing
                farmland and can also be useful for certain blocks.
            end

        end

    end


    section "Durability"

        subsection "Tool Maintenance"

            text
                Tools lose durability as they are used. Plan
                replacements, repairs, or upgrades before a tool
                becomes unusable.
            end

            tip
                Keep important replacement tools in your storage
                system before beginning long projects.
            end

        end

    end

end


topic "Items"

    description "Important item categories and inventory management."

    section "Food"

        subsection "Food Sources"

            list
                Crops
                Animals
                Fishing
                Generated Structures
                Trading
            end

        end


        subsection "Food Storage"

            text
                Keep commonly used food in an easily accessible
                inventory or storage location.
            end

        end

    end


    section "Building Materials"

        subsection "Common Materials"

            list
                Stone
                Cobblestone
                Deepslate
                Wood
                Glass
                Bricks
                Concrete
                Terracotta
            end

        end

    end


    section "Rare Items"

        subsection "Important Items"

            text
                Rare items should be stored carefully and,
                when possible, separated from ordinary building
                materials.
            end

            tip
                Create a dedicated valuables section in your
                storage system.
            end

        end

    end

end


topic "Exploration"

    description "Exploring the Minecraft world safely and efficiently."

    section "Preparing"

        subsection "Before Exploring"

            list
                Food
                Tools
                Weapon
                Armor
                Building Blocks
                Torches or Lighting
                Empty Inventory Space
                Coordinate Notes
            end

        end

    end


    section "Navigation"

        subsection "Coordinates"

            text
                Use coordinates to record where you are and to
                return to important locations.
            end

        end


        subsection "Landmarks"

            text
                Large buildings, towers, paths, signs, and other
                visible landmarks can make navigation easier.
            end

        end

    end


    section "Returning Home"

        subsection "Marking Your Base"

            text
                Make your base visually recognizable and record
                its coordinates before exploring far away.
            end

        end

    end

end


topic "Building Projects"

    description "Planning and organizing large Minecraft construction projects."

    section "Planning"

        subsection "Choose a Location"

            text
                Select a location that provides enough room for
                the complete project, including paths, entrances,
                walls, landscaping, and future expansion.
            end

        end


        subsection "Mark the Footprint"

            text
                Mark the outer boundaries before placing the main
                structure. This makes it easier to judge the scale
                before committing large amounts of resources.
            end

        end

        subsection "Plan the Height"

            text
                Consider the total height of the structure as well
                as its width and length. A large footprint with a
                very short structure can look flat, while excessive
                height can overwhelm the surrounding area.
            end

        end

    end


    section "Castles"

        subsection "Castle Basics"

            text
                A castle can include walls, towers, gates, courtyards,
                keeps, halls, storage areas, and defensive structures.
            end

            image "images/building/castle.png"
                title "Castle"
                alt "A large Minecraft castle."
                width 700
                position center
            end

        end


        subsection "Castle Walls"

            text
                Castle walls establish the defensive perimeter and
                can connect towers, gates, and other structures.
            end

        end


        subsection "Castle Towers"

            text
                Towers can be placed at corners, gates, or other
                important points along the castle perimeter.
            end

        end


        subsection "Castle Gate"

            text
                The gate is one of the most visually important
                entrances to a castle and can be designed as a
                major architectural feature.
            end

        end


        subsection "Keep"

            text
                A keep can serve as the central major structure
                of a castle and may contain important rooms,
                storage, halls, or other facilities.
            end

        end

    end


    section "Kingdoms"

        subsection "Kingdom Layout"

            text
                A large kingdom can contain multiple structures
                connected by roads, paths, walls, farms, fields,
                bridges, and other infrastructure.
            end

        end


        subsection "Roads"

            text
                Roads help connect major locations and make a
                large settlement feel organized.
            end

        end


        subsection "Districts"

            list
                Castle District
                Residential District
                Market District
                Farming District
                Industrial District
                Storage District
                Harbor District
                Military District
            end

        end

    end

end


topic "Farms"

    description "Farm planning, collection systems, and automation."

    section "Farm Planning"

        subsection "Input"

            text
                Determine what resource the farm is designed to
                produce before deciding how the farm should work.
            end

        end


        subsection "Production"

            text
                Identify the Minecraft mechanic that produces the
                desired resource.
            end

        end


        subsection "Collection"

            text
                Decide how produced items will reach storage.
                Collection may use hoppers, water, minecarts,
                or other mechanisms.
            end

        end


        subsection "Storage"

            text
                Connect the farm to an appropriately sized
                storage system so production does not immediately
                overflow.
            end

        end

    end


    section "Farm Categories"

        subsection "Crop Farms"

            text
                Crop farms produce renewable agricultural resources
                through planting, growing, and harvesting.
            end

        end


        subsection "Mob Farms"

            text
                Mob farms use spawning and collection mechanics
                to gather resources from mobs.
            end

            warning
                Mob farm designs can behave differently depending
                on the exact Minecraft edition, version, location,
                and surrounding conditions.
            end

        end


        subsection "Animal Farms"

            text
                Animal farms provide renewable access to animal
                products and food.
            end

        end

    end

end


topic "Useful Mechanics"

    description "General mechanics that are useful when designing builds and systems."

    section "Light"

        subsection "Lighting"

            text
                Lighting can improve visibility, decoration, and
                the appearance of buildings while also helping
                control certain gameplay conditions.
            end

        end

    end


    section "Water"

        subsection "Water Flow"

            text
                Water can be used for transportation, item
                collection, farming, decoration, and mechanisms.
            end

        end

    end


    section "Lava"

        subsection "Lava Uses"

            text
                Lava can be used as a fuel source in appropriate
                systems and as a decorative or environmental element.
            end

            warning
                Lava can destroy or damage builds and can create
                dangerous conditions. Plan containment carefully.
            end

        end

    end


    section "Mob Spawning"

        subsection "Spawning Conditions"

            text
                Mob spawning depends on Minecraft mechanics and
                conditions such as location and available space.
            end

        end

    end

end


topic "Minecraft Math"

    description "Useful calculations for planning Minecraft builds and systems."

    section "Areas"

        subsection "Rectangle"

            text
                For a rectangular area, multiply length by width
                to determine the number of blocks in one layer.
            end

            code
                area = length × width
            end

        end


        subsection "Multiple Layers"

            text
                Multiply the area of one layer by the number of
                layers when every layer has the same dimensions.
            end

            code
                total = length × width × height
            end

        end

    end


    section "Circles"

        subsection "Circle Planning"

            text
                Circular builds can be planned using a radius or
                diameter and then converted into block-based shapes.
            end

        end

    end


    section "Stacks"

        subsection "Stack Conversion"

            text
                Minecraft items are commonly stored in stacks.
                Use stack size when determining how many inventory
                slots or containers are required.
            end

        end

    end

end


topic "Tips"

    description "General tips for building, survival, and world management."

    section "Organization"

        subsection "Name Important Places"

            text
                Give important locations clear names and record
                their coordinates.
            end

        end


        subsection "Keep Projects Separate"

            text
                Large projects are easier to manage when their
                materials, plans, and storage are organized.
            end

        end

    end


    section "Building"

        subsection "Build in Stages"

            text
                Complete a large project in stages such as
                foundation, structure, detail, interior, and
                landscaping.
            end

        end


        subsection "Test First"

            text
                Build a small section first when experimenting
                with a new design. This makes it easier to change
                proportions before repeating the design across
                a large structure.
            end

        end

    end


    section "Redstone"

        subsection "Test Components"

            text
                Test individual redstone components before
                connecting an entire machine.
            end

            tip
                When debugging redstone, isolate one section at
                a time instead of changing the entire machine.
            end

        end

    end

end