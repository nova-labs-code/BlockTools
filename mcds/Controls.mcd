document "Minecraft Controls"
description "A complete controls reference for Minecraft Bedrock Edition, including default controls and configurable key bindings."

topic "Keyboard And Mouse"
    description "Default keyboard and mouse controls for Minecraft Bedrock Edition on PC."

    section "Movement"
        subsection "Basic Movement"
            text
W - Move forward.
A - Move left.
S - Move backward.
D - Move right.
Space - Jump.
Left Shift - Sneak.
Left Control - Sprint.
            end
        end

        subsection "Movement While Flying"
            text
Space - Fly upward in Creative Mode.
Left Shift - Fly downward in Creative Mode.
Double-tap Space - Start or stop flying in Creative Mode.
            end
        end
    end

    section "Mouse"
        subsection "Camera"
            text
Move the mouse - Look around.
            end
        end

        subsection "Mouse Buttons"
            text
Left mouse button - Attack or destroy blocks.
Right mouse button - Use an item, place a block, or interact with an object.
Mouse wheel - Change the selected hotbar slot.
Middle mouse button - Pick block in Creative Mode.
            end
        end
    end

    section "Hotbar"
        subsection "Selecting Items"
            text
1 through 9 - Select the corresponding hotbar slot.
Mouse wheel up or down - Cycle through hotbar slots.
            end
        end

        subsection "Offhand"
            text
F - Swap the selected item with the item in your offhand.
            end
        end
    end

    section "Inventory And Items"
        subsection "Inventory"
            text
E - Open or close the inventory.
            end
        end

        subsection "Item Management"
            text
Left click - Pick up or place an item stack.
Right click - Pick up or place half of a stack.
Shift + click - Quickly move an item between inventories.
Double click - Collect matching items into one stack when possible.
Drop key - Drop the selected item.
Q - Drop one item from the selected hotbar slot.
Ctrl + Q - Drop the entire selected stack.
            end
        end
    end

    section "Chat And Commands"
        subsection "Chat"
            text
T - Open chat.
Enter - Open chat.
            end
        end

        subsection "Commands"
            text
/ - Open chat with the command prefix.
Up Arrow - Recall a previous chat or command.
Tab - Complete names and command arguments when supported.
            end
        end
    end

    section "Interface"
        subsection "Menus"
            text
Esc - Open or close the pause menu.
            end
        end

        subsection "Information"
            text
F1 - Hide or show the HUD when supported.
F2 - Take a screenshot.
            end
        end
    end

    section "Multiplayer"
        subsection "Player List"
            text
Tab - Display the player list while held.
            end
        end
    end

    section "Creative Mode"
        subsection "Creative Inventory"
            text
E - Open the Creative inventory.
            end
        end

        subsection "Block Picking"
            text
Middle mouse button - Pick the block you are looking at.
            end
        end

        subsection "Flying"
            text
Double-tap Space - Start or stop flying.
Space - Fly upward.
Left Shift - Fly downward.
            end
        end
    end

    section "Configurable Key Bindings"
        subsection "Changing Keyboard Controls"
            text
Minecraft Bedrock Edition allows many keyboard and mouse controls to be changed from the Settings menu.

Open Settings, select Keyboard & Mouse, and choose the control you want to change.

Select the current key binding and press the new key or mouse button you want to assign.
            end
        end

        subsection "Key Conflicts"
            warning
Two actions may not be able to use the same key effectively. If a new binding conflicts with another action, review your controls and assign different keys where necessary.
            end
        end
    end

    section "Command Macros"
        subsection "Using Macros"
            text
Keyboard shortcuts and available command-related controls can vary depending on the version of Minecraft Bedrock Edition and the platform.
            end
        end
    end
end

topic "Xbox"
    description "Default Xbox controller controls for Minecraft Bedrock Edition."

    section "Movement And Camera"
        subsection "Movement"
            text
Left Stick - Move.
Press Left Stick - Sprint.
            end
        end

        subsection "Camera"
            text
Right Stick - Look around.
            end
        end
    end

    section "Actions"
        subsection "Basic Actions"
            text
A - Jump.
B - Sneak.
X - Attack or destroy blocks.
RT - Use an item, place a block, or interact.
            end
        end
    end

    section "Inventory And Items"
        subsection "Inventory"
            text
Y - Open or close the inventory.
            end
        end

        subsection "Hotbar"
            text
LB / RB - Change the selected hotbar slot.
            end
        end

        subsection "Offhand"
            text
Use the controller's assigned offhand or item-swap control when available.
            end
        end
    end

    section "Chat And Multiplayer"
        subsection "Chat"
            text
Open the chat interface using the controller's assigned chat control.
            end
        end

        subsection "Player List"
            text
Use the assigned multiplayer/player-list control to view players in the world.
            end
        end
    end

    section "Menus"
        subsection "Pause Menu"
            text
Menu - Open or close the pause menu.
            end
        end

        subsection "Navigation"
            text
D-pad - Navigate menus and select interface options.
A - Confirm a selection.
B - Go back.
            end
        end
    end

    section "Creative Mode"
        subsection "Flying"
            text
Double-tap A - Start or stop flying.
A - Fly upward.
B - Fly downward.
            end
        end

        subsection "Block Selection"
            text
Use the Creative inventory to select blocks and items.
            end
        end
    end

    section "Controller Customization"
        subsection "Changing Controls"
            text
Open Settings and select Controller to view and change available controller bindings.

Controller options may vary between Minecraft versions and devices.
            end
        end
    end
end

